PORT=3210

# --- Auth (Sprint 0, MEL-1755) ---
# AUTH_SECRET: 64+ hex chars. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=
# AUTH_USERS: comma-separated entries of `username:sha256hash:salt`.
# Generate one with: `node scripts/generate-auth-user.mjs pavel`
AUTH_USERS=

# --- Storage ---
# In production (NODE_ENV=production) this MUST be `postgres`; the server
# refuses to start otherwise.
STORAGE_DRIVER=file

# Postgres storage
# Use either DATABASE_URL or one of the Vercel Postgres URLs below.
# STORAGE_DRIVER=postgres
# DATABASE_URL=postgres://user:pass@host:5432/dbname
# POSTGRES_URL=postgres://user:pass@host:5432/dbname
# POSTGRES_PRISMA_URL=postgres://user:pass@host:5432/dbname
# POSTGRES_URL_NON_POOLING=postgres://user:pass@host:5432/dbname
# POSTGRES_BOOTSTRAP_FROM_FILE=true
# PG_POOL_MAX=3
# PG_CONNECT_TIMEOUT_MS=5000
# PG_IDLE_TIMEOUT_MS=10000
# POSTGRES_SSL_REJECT_UNAUTHORIZED=false

# Optional LLM runtime
# ANTHROPIC_API_KEY=

# Optional result delivery
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=simulator@mellow.io
# RESULT_EMAIL=onboarding-simulations@mellow.io
